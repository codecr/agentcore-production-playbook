// Policy: 02_allow_destructive_only_with_explicit_approval
// Category: Environment boundaries
// Intent: Destructive actions (terminate, delete) require an explicit approval
//         token in the request context. The approval token is generated by a
//         separate flow (typically a human-in-the-loop ticket) and passed
//         through to the tool call as context.input.approval_token.
// Protects against: Autonomous destructive actions. The agent cannot generate
//                   its own approval tokens; the token must come from outside
//                   the reasoning loop.

permit (
  principal,
  action in [
    AgentCore::Action::"devops___terminate_instance",
    AgentCore::Action::"devops___delete_resource",
    AgentCore::Action::"data___drop_table"
  ],
  resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:REGION:ACCOUNT:gateway/GATEWAY_ID"
)
when {
  context.input has approval_token &&
  context.input.approval_token like "approved-*"
};
